{ pkgs, lib, config, osConfig, ... }:

# Hyprland compositor config.
#
# The real config is plain Lua in ./hypr/, matching the Hyprland wiki 1:1.
# This file just deploys it to ~/.config/hypr/arlo/ and generates the
# pieces that come from Nix: colors (lib/palette.nix), env
# (lib/session-vars.nix) and the scratchpad list (scratchpads.nix).
#
#   ~/.config/hypr/hyprland.lua          written by Home Manager, loads the rest
#   ~/.config/hypr/arlo/palette.lua      GENERATED from palette.nix
#   ~/.config/hypr/arlo/env.lua          GENERATED from session-vars.nix
#   ~/.config/hypr/arlo/scratchpads.lua  GENERATED from scratchpads.nix
#   ~/.config/hypr/arlo/*.lua            copied from ./hypr/
#
# Related: helpers.nix (lock, idle, wallpaper, launcher) and quickshell.nix
# (bar and notifications).

let
  sessionVars = import ../../lib/session-vars.nix;
  colors = (import ../../lib/palette.nix).for "hyprland";
  scratchpads = import ./scratchpads.nix;

  # Set only inside Hyprland. Hosts add their own (e.g. NVIDIA's) through
  # fox.desktop.hyprlandEnv.
  hyprlandOnlyVars = osConfig.fox.desktop.hyprlandEnv // {
    # Qt apps take their look from qt5ct / qt6ct (theme.nix). qt6ct answers
    # to "qt5ct" too, so this one value covers Qt 5 and Qt 6 apps.
    QT_QPA_PLATFORMTHEME = "qt5ct";
    # The cursor set in theme.nix.
    XCURSOR_THEME = config.home.pointerCursor.name;
    XCURSOR_SIZE = toString config.home.pointerCursor.size;
  };

  # Hyprland's env can't expand $HOME, so it's substituted here.
  envVars = lib.mapAttrs
    (_: v: lib.replaceStrings [ "$HOME" ] [ config.home.homeDirectory ] v)
    (sessionVars // hyprlandOnlyVars);

  # Per-host monitor rules (fox.desktop.monitors), after the catch-all.
  monitorRules = lib.concatMapStrings
    (m: "hl.monitor(${lib.generators.toLua { } m})\n")
    osConfig.fox.desktop.monitors;

  # Lua files written into ~/.config/hypr/arlo/. require("arlo.x") loads x.lua.
  # webapps.lua is generated by webapps.nix.
  luaModules = [ "env" "looks" "input" "binds" "rules" "webapps" ];
in
{
  # Tie every Wayland helper service (quickshell, hypridle, hyprpaper, ...)
  # to the Hyprland session, so they start and stop with it.
  # Requires wayland.windowManager.hyprland.systemd.enable (set below).
  wayland.systemd.target = "hyprland-session.target";

  wayland.windowManager.hyprland = {
    enable = true;

    # Hyprland 0.55 deprecated hyprlang in favor of Lua; hyprlang support is
    # due to be removed in a coming release. Everything here is Lua.
    configType = "lua";

    package = null;         # installed by programs.hyprland in modules/desktop/session.nix
    portalPackage = null;
    systemd.enable = true;  # provides hyprland-session.target

    # Start XDG autostart entries (Mullvad, NetBird UI, ...) so their tray
    # icons appear.
    systemd.enableXdgAutostart = true;

    # Appended to the generated hyprland.lua. Order matters: palette and env
    # load first because everything after uses them.
    extraConfig = ''
      hl.monitor({
          output   = "",          -- any monitor
          mode     = "preferred",
          position = "auto",
          scale    = 1,
      })

    '' + monitorRules + lib.concatMapStrings (m: ''require("arlo.${m}")'' + "\n") luaModules + ''

      -- Lock immediately on login, so autologin boots to the lock screen.
      hl.on("hyprland.start", function()
          hl.exec_cmd("hyprlock")
          -- Chat apps (and any scratchpad marked autostart) start hidden
          -- in their scratchpads; rules.lua sends them there silently.
    '' + lib.concatMapStrings (p: lib.optionalString ((p.chat or false) || (p.autostart or false))
      "      hl.exec_cmd(${lib.generators.toLua { } p.cmd})\n") scratchpads + ''
      end)
    '';
  };

  xdg.configFile = {
    "hypr/arlo/palette.lua".text = ''
      -- GENERATED from palette.nix by hyprland.nix. Edit palette.nix, not this.
      local p = {
      ${lib.concatStrings (lib.mapAttrsToList (n: v: "    ${n} = ${lib.generators.toLua { } v},\n") colors)}}

      -- Hyprland color strings: p.rgb(p.forest) -> "rgb(255C2B)"
      function p.rgb(hex) return "rgb(" .. hex .. ")" end
      -- With alpha as two hex digits: p.rgba(p.bg, "cc") -> "rgba(131A16cc)"
      function p.rgba(hex, alpha) return "rgba(" .. hex .. alpha .. ")" end

      return p
    '';

    "hypr/arlo/env.lua".text = ''
      -- GENERATED by hyprland.nix from session-vars.nix (plus Hyprland-only
      -- vars defined there). Edit those, not this.
      ${lib.concatStrings (lib.mapAttrsToList (n: v: "hl.env(${lib.generators.toLua { } n}, ${lib.generators.toLua { } v})\n") envVars)}'';

    "hypr/arlo/looks.lua".source = ./hypr/looks.lua;
    "hypr/arlo/input.lua".source = ./hypr/input.lua;
    "hypr/arlo/binds.lua".source = ./hypr/binds.lua;
    "hypr/arlo/rules.lua".source = ./hypr/rules.lua;
    "hypr/arlo/windows.lua".source = ./hypr/windows.lua;

    # binds.lua, rules.lua and windows.lua load this with
    # require("arlo.scratchpads").
    "hypr/arlo/scratchpads.lua".text = ''
      -- GENERATED by hyprland.nix from scratchpads.nix. Edit that, not this.
      return ${lib.generators.toLua { } scratchpads}
    '';
  };

  # Reload a running Hyprland after a switch, so edits take effect without
  # logging out. (Home Manager only does this itself when it owns the package.)
  # Same approach as Home Manager's own reload snippet.
  home.activation.reloadHyprland = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
    export XDG_RUNTIME_DIR=''${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    if [[ -d "$XDG_RUNTIME_DIR/hypr" ]]; then
      for i in $(${pkgs.hyprland}/bin/hyprctl instances -j | ${pkgs.jq}/bin/jq -r '.[].instance'); do
        run ${pkgs.hyprland}/bin/hyprctl -i "$i" reload config-only >/dev/null || true
      done
    fi
  '';
}

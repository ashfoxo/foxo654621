{ pkgs, lib, nixpak, osConfig, ... }:

# Web apps: each site runs in its own sandboxed ungoogled-chromium
# (sandboxes.nix), in app mode: no tabs, no address bar, its own window.
#
# One list drives everything. Adding an app here gives you:
#   - a `webapp-<id>` command
#   - an entry in the launcher (Super + R)
#   - a Hyprland rule sending it to its workspace (generated arlo/webapps.lua);
#     leave `workspace` out for apps that are scratchpads (scratchpads.nix)
# Then add the matching line to sandboxes.nix (one per app).
#
# All traffic goes through Mullvad like everything else. Nothing here is
# split-tunneled.

let
  sandboxes = import ./sandboxes.nix {
    inherit pkgs nixpak;
    extraGpuDev = osConfig.fox.desktop.sandboxGpuDevices;
    extraGpuEnv = osConfig.fox.desktop.sandboxGpuEnv;
  };

  apps = [
    { id = "ente";   name = "Ente";   url = "https://web.ente.io";      host = "web.ente.io";      workspace = 6; }
    { id = "tuta";   name = "Tuta";   url = "https://app.tuta.com";     host = "app.tuta.com";     workspace = 5; }
    { id = "claude"; name = "Claude"; url = "https://claude.ai";        host = "claude.ai";        workspace = 3; }
    { id = "elk";    name = "Elk";    url = "https://elk.zone";         host = "elk.zone";         workspace = 5; }
    { id = "gmail";  name = "Gmail";  url = "https://mail.google.com";  host = "mail.google.com";  workspace = 5; }
    { id = "messages"; name = "Messages"; url = "https://messages.google.com/web"; host = "messages.google.com"; }
    { id = "appletv"; name = "Apple TV"; url = "https://tv.apple.com"; host = "tv.apple.com";     workspace = 8; }
    { id = "spotify"; name = "Spotify"; url = "https://open.spotify.com/"; host = "open.spotify.com"; workspace = 8; }
  ];

  # --password-store=basic: the sandbox has no access to your Secret Service,
  # and without this flag Chromium stalls looking for one at startup. Saved
  # logins and cookies are then protected by the disk encryption (LUKS), not
  # a keyring.
  launcher = app: pkgs.writeShellScriptBin "webapp-${app.id}" ''
    exec ${sandboxes."webapp-${app.id}"}/bin/chromium \
      --app=${app.url} \
      --no-first-run \
      --no-default-browser-check \
      --password-store=basic \
      "$@"
  '';

  # Chromium names an app window's Wayland class after the site, e.g.
  # "chrome-app.tuta.com__-Default". Matching on the host keeps the rule
  # working whatever the exact prefix/suffix turns out to be.
  escapeRegex = s: lib.replaceStrings [ "." ] [ "\\\\." ] s;
in
{
  home.packages = map launcher apps;

  xdg.desktopEntries = lib.listToAttrs (map (app: {
    name = "webapp-${app.id}";
    value = {
      name = app.name;
      exec = "webapp-${app.id}";
      icon = "internet-web-browser";
      categories = [ "Network" ];
      comment = "${app.name} (sandboxed web app)";
    };
  }) apps);

  xdg.configFile."hypr/arlo/webapps.lua".text = ''
    -- GENERATED by webapps.nix. Edit the app list there, not this file.
    ${lib.concatMapStrings (app: lib.optionalString (app ? workspace) ''
      hl.window_rule({
          name      = "webapp-${app.id}",
          match     = { class = ".*${escapeRegex app.host}.*" },
          workspace = "${toString app.workspace}",
      })
    '') apps}'';
}

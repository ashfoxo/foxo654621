# fox-amber: the laptop (Intel, Dell). Its name in this repo; on the
# network it still goes by workstation (networking.hostName below), and its
# backups keep living under amberbagger/workstation.
{
  imports = [
    ./hardware-configuration.nix   # generated by the installer, don't hand-write
    ../../modules/personal.nix
    ../../modules/hardware/laptop.nix
  ];

  networking.hostName = "workstation";
  fox.machine = "fox-amber";

  fox.backup.repository = "s3:https://s3.fr-par.scw.cloud/amberbagger/workstation";

  # TRANSITION: the laptop's own host key, which secrets.yaml was encrypted
  # to before the shared key existed. Keeps the laptop decrypting while the
  # switch happens. Remove this line, and the matching age key in
  # .sops.yaml, once README.md step C5 is done.
  sops.age.sshKeyPaths = [ "/persist/etc/ssh/ssh_host_ed25519_key" ];

  system.stateVersion = "26.05";
}

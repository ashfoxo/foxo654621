# fox-amber: the laptop (Intel, Dell). Its name in this repo; on the
# network it goes by workstation (networking.hostName below), a generic name
# so a mobile machine blends into whatever network it joins.
{
  imports = [
    ./hardware-configuration.nix   # generated by the installer, don't hand-write
    ../../modules/personal.nix
    ../../modules/hardware/laptop.nix
    ../../modules/services/auto-update.nix   # daily flake update, built for the next boot
  ];

  networking.hostName = "workstation";
  fox.machine = "fox-amber";

  fox.backup.repository = "s3:https://s3.fr-par.scw.cloud/bagger-amber/fox-amber";
  # Its own Scaleway API key: fox-amber-s3-* in secrets.yaml.
  fox.backup.s3SecretPrefix = "fox-amber-";

  system.stateVersion = "26.05";
}
